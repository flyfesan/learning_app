{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist",
    "public/pagefind"
  ],
  "compilerOptions": {
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@contracts/*": [
        "contracts/*"
      ]
    },
    "baseUrl": ".",
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}