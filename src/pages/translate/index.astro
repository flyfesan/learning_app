---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import SelectTrigger from "@/components/starwind/select/SelectTrigger.astro";
import SelectValue from "@/components/starwind/select/SelectValue.astro";
import SelectItem from "@/components/starwind/select/SelectItem.astro";
import { useTranslations } from "@/i18n";
import Layout from "@/layouts/Layout.astro";
import config from "@/config";
import Main from "@/components/Main.astro";
import Textarea from "@/components/starwind/textarea/Textarea.astro";
import Select from "@/components/starwind/select/Select.astro";
import SelectContent from "@/components/starwind/select/SelectContent.astro";
import Button from "@/components/starwind/button/Button.astro";

const t = useTranslations(Astro.currentLocale ?? config.site.lang);

const languages = [
  { code: "ja", name: "Japanese" },
  { code: "en", name: "English" },
  { code: "es", name: "Spanish" },
  { code: "fr", name: "French" },
  { code: "de", name: "German" },
];
---

<script>
  import { actions } from "astro:actions";
  import { atom } from "nanostores";
  import { state } from "./state";

  const resetTextArea = () => {
    const textArea = document.getElementById(
      "translateInput",
    ) as HTMLTextAreaElement;

    if (textArea) {
      textArea.value = "";
    }
  };

  const resetState = () => {
    state.set({ kind: "idle" });
  };

  const isPending = atom(false);
  const form = document.querySelector("form") as HTMLFormElement;
  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    const formData = new FormData(form);
    resetState();
    try {
      isPending.set(true);
      const { data, error } = await actions.translate(formData);
      console.log(`translate data ${JSON.stringify(data)}`);

      if (error) {
        state.set({
          kind: "error",
          error: error.message ?? "Translation failed",
        });

        isPending.set(false);
        return;
      }

      state.set({
        kind: "success",
        translation: data.result,
      });
    } finally {
      isPending.set(false);
      resetTextArea();
    }
  });

  state.subscribe((value) => {
    const resultContainer = document.getElementById(
      "resultContainer",
    ) as HTMLElement;
    const errorContainer = document.getElementById(
      "errorContainer",
    ) as HTMLElement;
    if (value.kind === "error") {
      if (errorContainer) {
        const errorText = document.getElementById("errorText") as HTMLElement;
        errorText.textContent = value.error ?? "An error occurred";
        errorContainer.removeAttribute("hidden");
      }
    } else if (value.kind === "success") {
      if (resultContainer) {
        const resultText = document.getElementById("resultText") as HTMLElement;
        resultText.textContent = value.translation;
        resultContainer.removeAttribute("hidden");
      }
    } else {
      if (resultContainer) {
        resultContainer.setAttribute("hidden", "true");
      }
      if (errorContainer) {
        errorContainer.setAttribute("hidden", "true");
      }
    }
  });
</script>

<Layout title={`${t.pages.translateTitle} | ${config.site.title}`}>
  <Header />
  <Main
    pageTitle={`${t.pages.translateDesc}`}
    class="py-10 flex flex-col items-center gap-4 px-4"
  >
    <form class="flex flex-col items-center gap-4 w-full">
      <div class="w-full mt-4" id="errorContainer" hidden>
        <p class="text-sm text-error" role="alert" id="errorText"></p>
      </div>

      <div class="flex gap-4 w-full self-center justify-center">
        <Select name="source" required>
          <SelectTrigger size="sm" class="w-[180px]">
            <SelectValue placeholder="Source Language" />
          </SelectTrigger>
          <SelectContent size="sm">
            <SelectItem value="" disabled>Source Language</SelectItem>
            {
              languages.map(({ code, name }) => (
                <SelectItem value={code}>{name}</SelectItem>
              ))
            }
          </SelectContent>
        </Select>
        <Select name="target" required>
          <SelectTrigger size="sm" class="w-[180px]">
            <SelectValue placeholder="Target Language" />
          </SelectTrigger>
          <SelectContent size="sm">
            <SelectItem value="" disabled>Target Language</SelectItem>
            {
              languages.map(({ code, name }) => (
                <SelectItem value={code}>{name}</SelectItem>
              ))
            }
          </SelectContent>
        </Select>
      </div>
      <Textarea
        id="translateInput"
        name="text"
        placeholder="Enter text to translate"
        size="lg"
        class="border-2 p-4 rounded h-56 w-full"
        required
      />
      <Button class="px-4 py-2 rounded-3xl self-end" type="submit">
        {t.action.translate}
      </Button>
    </form>

    <section class="w-full rounded border p-4" id="resultContainer" hidden>
      <h2 class="mb-2 text-sm font-semibold">Translation</h2>
      <p id="resultText"></p>
    </section>
  </Main>
  <Footer />
</Layout>
